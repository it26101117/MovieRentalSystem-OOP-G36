<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="
         http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>


    <!-- =====================================================
         SPRING BOOT PARENT
    ====================================================== -->

    <parent>

        <groupId>
            org.springframework.boot
        </groupId>

        <artifactId>
            spring-boot-starter-parent
        </artifactId>

        <version>
            3.5.16
        </version>

        <relativePath/>

    </parent>


    <!-- =====================================================
         PROJECT INFORMATION
    ====================================================== -->

    <groupId>
        com.movierental
    </groupId>

    <artifactId>
        MovieRentalPlatform
    </artifactId>

    <version>
        1.0-SNAPSHOT
    </version>

    <name>
        MovieRentalPlatform
    </name>

    <description>
        CineRent Movie Rental and Review Platform
    </description>


    <!--
        JSP works best with WAR packaging
    -->
    <packaging>
        war
    </packaging>


    <!-- =====================================================
         JAVA / ENCODING
    ====================================================== -->

    <properties>

        <!-- Java 19 -->
        <java.version>
            19
        </java.version>

        <project.build.sourceEncoding>
            UTF-8
        </project.build.sourceEncoding>

        <project.reporting.outputEncoding>
            UTF-8
        </project.reporting.outputEncoding>

    </properties>


    <!-- =====================================================
         DEPENDENCIES
    ====================================================== -->

    <dependencies>


        <!-- =================================================
             SPRING BOOT WEB

             Includes:
             - Spring MVC
             - Jakarta Servlet API
             - Embedded Tomcat
             - Web application support
        ================================================== -->

        <dependency>

            <groupId>
                org.springframework.boot
            </groupId>

            <artifactId>
                spring-boot-starter-web
            </artifactId>

        </dependency>


        <!-- =================================================
             JSP SUPPORT

             Required so embedded Tomcat can compile and
             display .jsp files.
        ================================================== -->

        <dependency>

            <groupId>
                org.apache.tomcat.embed
            </groupId>

            <artifactId>
                tomcat-embed-jasper
            </artifactId>

        </dependency>


        <!-- =================================================
             SPRING BOOT TESTING

             Useful later for unit/integration testing.
        ================================================== -->

        <dependency>

            <groupId>
                org.springframework.boot
            </groupId>

            <artifactId>
                spring-boot-starter-test
            </artifactId>

            <scope>
                test
            </scope>

        </dependency>


    </dependencies>


    <!-- =====================================================
         BUILD
    ====================================================== -->

    <build>


        <!-- Generated WAR name -->

        <finalName>
            MovieRentalPlatform
        </finalName>


        <plugins>


            <!-- =============================================
                 SPRING BOOT MAVEN PLUGIN

                 Allows:
                 mvn spring-boot:run

                 and creates Spring Boot executable WAR.
            ============================================== -->

            <plugin>

                <groupId>
                    org.springframework.boot
                </groupId>

                <artifactId>
                    spring-boot-maven-plugin
                </artifactId>

            </plugin>


            <!-- =============================================
                 JAVA COMPILER
            ============================================== -->

            <plugin>

                <groupId>
                    org.apache.maven.plugins
                </groupId>

                <artifactId>
                    maven-compiler-plugin
                </artifactId>

                <configuration>

                    <release>
                        19
                    </release>

                </configuration>

            </plugin>


        </plugins>

    </build>


</project>